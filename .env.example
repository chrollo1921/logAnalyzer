# Copy this file to .env and fill in your values: cp .env.example .env
# .env is git-ignored. Never commit real keys. Variables already set in your shell win over .env.

# --- Option A: a LiteLLM proxy -----------------------------------------------------------
# The proxy URL, with or without a trailing /v1. The app calls <url>/v1/messages.
LITELLM_BASE_URL=https://litellm.example.com
# Your LiteLLM virtual key.
LITELLM_API_KEY=sk-replace-me
# The model name as your proxy knows it (its model_name alias), if it is not claude-opus-5-5.
SAPCX_LA_MODEL=claude-opus-5-5
# Server-side refusal fallback is an Anthropic API beta that a proxy may not pass on.
# Leave this false behind LiteLLM unless you know your proxy supports it.
SAPCX_LA_USE_REFUSAL_FALLBACK=false

# --- Option B: the Anthropic API directly -------------------------------------------------
# Comment out the LITELLM_* lines above and set your Anthropic key instead.
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Web chat (serve), optional -----------------------------------------------------------
# SAPCX_LA_SERVER_AUTH=token
# SAPCX_LA_SERVER_ACCESS_TOKEN=replace-with-a-long-random-key
